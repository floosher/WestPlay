{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../target/release/westplay.dll": "westplay.dll",
      "../target/release/libwestplay.so": "libwestplay.so",
      "../target/release/westplay-maps.exe": "westplay-maps.exe",
      "../target/release/westplay-maps": "westplay-maps",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1",
          "librsvg2-2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": [
          "English", "Turkish", "German", "French", "Spanish", "SpanishInternational", "Italian", "PortugueseBR",
          "Portuguese", "Dutch", "Polish", "Russian", "Ukrainian", "Czech", "Slovak", "Bulgarian", "Croatian",
          "Slovenian", "Serbian", "SerbianLatin", "Macedonian", "Danish", "Swedish", "Norwegian", "Finnish",
          "Estonian", "Latvian", "Lithuanian", "Hungarian", "Romanian", "Greek", "Catalan", "Basque", "Galician",
          "Georgian", "Japanese", "Korean", "SimpChinese", "TradChinese", "Vietnamese"
        ]
      }
    }
  }
}
